{
  "name": "universal-auth-kit",
  "version": "1.0.0",
  "description": "Universal authentication kit for React, Node.js, and Next.js applications",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js"
    },
    "./server": {
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js"
    },
    "./next": {
      "import": "./dist/next/index.mjs",
      "require": "./dist/next/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').existsSync('dist') && require('fs').rmSync('dist', { recursive: true, force: true }); console.log('Cleaned dist directory')\"",
    "build": "node build-simple.js",
    "dev": "node build-simple.js && echo 'Watching for changes...'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "authentication",
    "auth",
    "react",
    "nextjs",
    "node",
    "jwt",
    "token"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "esbuild": "^0.20.2",
    "rimraf": "^5.0.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "jsonwebtoken": "^9.0.2"
  },
  "peerDependencies": {
    "express": ">=4.17.0",
    "next": ">=12.0.0",
    "react": ">=17.0.0"
  }
}
